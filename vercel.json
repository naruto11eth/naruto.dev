{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.naruto.dev" }],
      "destination": "https://naruto.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "naruto11.dev" }],
      "destination": "https://naruto.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.naruto11.dev" }],
      "destination": "https://naruto.dev/:path*",
      "permanent": true
    }
  ]
}
